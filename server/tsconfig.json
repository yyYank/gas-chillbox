{
  // GAS 用のサーバーコード。import/export を書かないスクリプトとして、
  // clasp の push 対象（viewer/src/Code.js）へそのまま出力する。
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "preserve",
    "moduleDetection": "legacy",
    "strict": true,
    "noUnusedLocals": false,
    "removeComments": false,
    "outDir": "../viewer/src",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": ["google-apps-script"]
  },
  "include": ["Code.ts"]
}
